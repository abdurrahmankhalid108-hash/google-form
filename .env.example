# The Gmail account below SENDS the emails. By default it also RECEIVES a copy of
# every note (with Reply-To set to the visitor). The confirmation goes to whatever
# Gmail address the visitor types in the form.
#
# Setup:
# 1. Turn on 2-Step Verification for this Google account.
# 2. Create an App Password: Google Account -> Security -> App passwords -> Mail.
# 3. Paste the 16-character app password below. Spaces are fine.
# 4. Copy this file to ".env", then run start.bat and open http://localhost:8787
# 5. Edits to .env apply on the next request; only PORT needs a restart.
#
GMAIL_USER=your.name@gmail.com
GMAIL_APP_PASSWORD=
# Optional: deliver notes to a different inbox. Leave empty to use GMAIL_USER.
NOTIFY_TO=
PORT=8787
